---
import { CartCounter } from "../cart/CartCounter";

const { isLoggedIn, isAdmin } = Astro.locals;
---

<!-- component -->
<nav
  class="flex justify-between px-6 md:px-20 py-10 items-center fixed top-0 w-full z-10 h-20"
  style="background-color: #F9F9F9;"
>
  <h1 class="text-lg sm:text-4xl font-bold inline-block bg-gradient-to-r from-purple-600 via-green-500 to-indigo-400 bg-clip-text text-transparent">
    <a href="/">AstroStore</a>
  </h1>
  <div class="flex items-center">
    <ul class="flex items-center space-x-2 sm:space-x-6">
      <CartCounter client:load transition:persist/>
      <li class="font-semibold text-gray-700">
        <a href="/" class="text-sm sm:text-[16px]">Home</a>
      </li>
      {
        isAdmin && (
          <li class="font-semibold text-gray-700">
            <a href="/admin/dashboard" class="text-sm sm:text-[16px]">Admin</a>
          </li>
        )
      }

      {
        !isLoggedIn ? (
          <li class="font-semibold text-gray-700">
            <a href="/login" class="text-sm sm:text-[16px]">Ingresar</a>
          </li>
        ) : (
          <li id="logout" class="font-semibold text-gray-700">
            <a href="#" class="text-sm sm:text-[16px]">Salir</a>
          </li>
        )
      }
    </ul>
  </div>
</nav>

<script>
  const { signOut } = await import('auth-astro/client');

  const logoutElem = document.querySelector('#logout') as HTMLLIElement;

  logoutElem?.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/';
  });
</script>
